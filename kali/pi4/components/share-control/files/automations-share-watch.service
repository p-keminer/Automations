[Unit]
Description=Inspect and refresh the selected Pi4 sharing uplink
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/automations/share --internal-watch
TimeoutStartSec=0
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
