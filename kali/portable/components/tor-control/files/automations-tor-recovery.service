[Unit]
Description=Verify and recover the optional guarded VM Tor client
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/automations-host/tor --recovery-worker
TimeoutStartSec=180
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
UMask=0077
