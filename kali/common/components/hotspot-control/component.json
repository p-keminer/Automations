{
  "schema_version": 1,
  "id": "hotspot-control",
  "version": "0.1.6",
  "name": "Isolated USB welcome access point",
  "description": "Optional runtime-only welcome AP on either external USB radio, with a customizable captive page and selected-uplink Internet sharing. ctrl0 stays protected.",
  "default_enabled": false,
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "requires": [
    "auto-cli",
    "wifi-control",
    "share-control"
  ],
  "minimum_versions": {
    "auto-cli": "0.1.4",
    "wifi-control": "0.1.3",
    "share-control": "0.1.8",
    "anonymity-runtime": "0.1.4"
  },
  "packages": [
    "python3",
    "hostapd",
    "dnsmasq",
    "nginx",
    "network-manager",
    "iw",
    "iproute2",
    "nftables",
    "systemd"
  ],
  "files": [
    {
      "source": "pi4/python/auto_hotspot.py",
      "destination": "usr/local/libexec/automations-support/hotspot.py",
      "mode": "0755"
    },
    {
      "source": "pi4/components/hotspot-control/files/automations-hotspot.service",
      "destination": "etc/systemd/system/automations-hotspot.service",
      "mode": "0644"
    },
    {
      "source": "pi4/python/templates/hotspot/welcome.html",
      "destination": "usr/local/share/automations/hotspot/welcome.html",
      "mode": "0644"
    },
    {
      "source": "common/docs/de/hotspot-control.txt",
      "destination": "usr/local/share/automations/help/docs/de/hotspot-control.txt",
      "mode": "0644"
    },
    {
      "source": "common/docs/en/hotspot-control.txt",
      "destination": "usr/local/share/automations/help/docs/en/hotspot-control.txt",
      "mode": "0644"
    },
    {
      "source": "common/components/hotspot-control/files/completion",
      "destination": "usr/local/share/automations/completions/share-ap",
      "mode": "0644"
    }
  ]
}
