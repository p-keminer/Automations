{
  "schema_version": 1,
  "id": "wifi-control",
  "version": "0.2.0",
  "name": "External USB Wi-Fi control",
  "description": "Optional native NetworkManager and iw controls for one external USB Wi-Fi adapter while protecting the entire Pi4 control radio.",
  "default_enabled": false,
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64",
      "amd64"
    ]
  },
  "packages": [
    "python3",
    "network-manager",
    "iw",
    "iproute2",
    "systemd",
    "python3-dbus",
    "python3-gi"
  ],
  "files": [
    {
      "source": "pi4/python/wifi_autoconnect.py",
      "destination": "usr/local/libexec/automations-support/wifi_autoconnect.py",
      "mode": "0755"
    },
    {
      "source": "pi4/components/wifi-control/files/automations-wifi-policy.service",
      "destination": "etc/systemd/system/automations-wifi-policy.service",
      "mode": "0644"
    },
    {
      "source": "pi4/components/wifi-control/files/20-automations-wifi-policy.conf",
      "destination": "etc/systemd/system/NetworkManager.service.d/20-automations-wifi-policy.conf",
      "mode": "0644"
    },
    {
      "source": "common/python/auto_wifi.py",
      "destination": "usr/local/libexec/automations/wifi",
      "mode": "0755"
    },
    {
      "source": "common/components/wifi-control/files/completion",
      "destination": "usr/local/share/automations/completions/wifi",
      "mode": "0644"
    },
    {
      "source": "common/docs/de/wifi-control.txt",
      "destination": "usr/local/share/automations/help/docs/de/wifi-control.txt",
      "mode": "0644"
    },
    {
      "source": "common/docs/en/wifi-control.txt",
      "destination": "usr/local/share/automations/help/docs/en/wifi-control.txt",
      "mode": "0644"
    },
    {
      "source": "portable/python/host_wifi.py",
      "destination": "usr/local/libexec/automations-host/wifi",
      "mode": "0755"
    }
  ],
  "minimum_versions": {
    "auto-cli": "0.2.0"
  },
  "requires": [
    "auto-cli"
  ]
}
