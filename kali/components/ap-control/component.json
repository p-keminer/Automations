{
  "schema_version": 1,
  "id": "ap-control",
  "version": "0.1.3",
  "name": "Control WLAN visibility",
  "description": "Persist the managed Pi4 SSID visibility and apply it through a bounded hostapd restart; control WLAN reconnects briefly.",
  "default_enabled": false,
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "packages": [
    "python3",
    "hostapd",
    "iproute2",
    "systemd"
  ],
  "files": [
    {
      "source": "python/auto_ap.py",
      "destination": "usr/local/libexec/automations/ap",
      "mode": "0755"
    },
    {
      "source": "components/ap-control/files/completion",
      "destination": "usr/local/share/automations/completions/ap",
      "mode": "0644"
    },
    {
      "source": "python/docs/de/ap-control.txt",
      "destination": "usr/local/share/automations/help/docs/de/ap-control.txt",
      "mode": "0644"
    },
    {
      "source": "python/docs/en/ap-control.txt",
      "destination": "usr/local/share/automations/help/docs/en/ap-control.txt",
      "mode": "0644"
    }
  ]
}
