{
  "schema_version": 1,
  "id": "tor-control",
  "version": "0.1.12",
  "name": "Optional guarded Tor client and exit verification",
  "description": "Route shared IPv4 TCP through Tor and verify IPs against freshly downloaded observed Tor exit addresses.",
  "default_enabled": false,
  "requires": [
    "anonymity-runtime"
  ],
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "packages": [
    "python3",
    "tor",
    "ca-certificates",
    "systemd"
  ],
  "files": [
    {
      "source": "python/auto_tor.py",
      "destination": "usr/local/libexec/automations/tor",
      "mode": "0755"
    },
    {
      "source": "components/tor-control/files/completion",
      "destination": "usr/local/share/automations/completions/tor",
      "mode": "0644"
    },
    {
      "source": "components/tor-control/files/torrc",
      "destination": "usr/local/share/automations/tor/torrc",
      "mode": "0644"
    },
    {
      "source": "components/tor-control/files/tor-user.conf",
      "destination": "usr/local/share/automations/tor/tor-user.conf",
      "mode": "0644"
    },
    {
      "source": "components/tor-control/files/automations-tor.service",
      "destination": "etc/systemd/system/automations-tor.service",
      "mode": "0644"
    },
    {
      "source": "components/tor-control/files/automations-tor-recovery.service",
      "destination": "etc/systemd/system/automations-tor-recovery.service",
      "mode": "0644"
    },
    {
      "source": "components/tor-control/files/automations-tor-recovery.timer",
      "destination": "etc/systemd/system/automations-tor-recovery.timer",
      "mode": "0644"
    },
    {
      "source": "python/docs/de/tor-control.txt",
      "destination": "usr/local/share/automations/help/docs/de/tor-control.txt",
      "mode": "0644"
    },
    {
      "source": "python/docs/en/tor-control.txt",
      "destination": "usr/local/share/automations/help/docs/en/tor-control.txt",
      "mode": "0644"
    }
  ],
  "minimum_versions": {
    "anonymity-runtime": "0.1.7",
    "auto-cli": "0.1.2"
  }
}
