{
  "schema_version": 1,
  "id": "awus036acm",
  "version": "0.1.1",
  "name": "ALFA AWUS036ACM",
  "description": "Optionale native Treiber- und Firmware-Voraussetzungen sowie eine lesende USB- und WLAN-Erkennung f\u00fcr AWUS036ACM-kompatible Hardware.",
  "default_enabled": false,
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "hardware": {
    "usb_ids": [
      "0e8d:7612"
    ],
    "kernel_modules": [
      "mt76x2u"
    ]
  },
  "packages": [
    "python3",
    "network-manager",
    "firmware-mediatek"
  ],
  "files": [
    {
      "source": "python/awus036acm.py",
      "destination": "usr/local/bin/awus-status",
      "mode": "0755"
    },
    {
      "source": "python/docs/de/awus036acm.txt",
      "destination": "usr/local/share/automations/help/docs/de/awus036acm.txt",
      "mode": "0644"
    },
    {
      "source": "python/docs/en/awus036acm.txt",
      "destination": "usr/local/share/automations/help/docs/en/awus036acm.txt",
      "mode": "0644"
    }
  ]
}
