{
  "schema_version": 1,
  "id": "ssh-control",
  "version": "0.1.5",
  "name": "Pi4 direct SSH control",
  "description": "Control-network-only SSH switching and selective direct-connection termination, preserving Guacamole sessions.",
  "default_enabled": false,
  "targets": {
    "distributions": [
      "kali"
    ],
    "architectures": [
      "arm64"
    ]
  },
  "packages": [
    "python3",
    "openssh-server",
    "nftables",
    "systemd",
    "iproute2"
  ],
  "files": [
    {
      "source": "python/auto_ssh.py",
      "destination": "usr/local/libexec/automations/ssh",
      "mode": "0755"
    },
    {
      "source": "components/ssh-control/files/completion",
      "destination": "usr/local/share/automations/completions/ssh",
      "mode": "0644"
    },
    {
      "source": "python/docs/de/ssh-control.txt",
      "destination": "usr/local/share/automations/help/docs/de/ssh-control.txt",
      "mode": "0644"
    },
    {
      "source": "python/docs/en/ssh-control.txt",
      "destination": "usr/local/share/automations/help/docs/en/ssh-control.txt",
      "mode": "0644"
    }
  ]
}
